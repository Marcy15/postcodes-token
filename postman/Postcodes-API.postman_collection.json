          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Lapozott adatok\",()=>{ const j=pm.response.json(); pm.expect(j.data).to.be.an(\"array\"); pm.expect(j.meta).to.be.an(\"object\");});"
